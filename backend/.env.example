# =============================================================================
# Local RAG backend — environment configuration
# Copy this file to `.env` and fill in real values. Never commit `.env`.
# =============================================================================

# --- Database (Supabase) ----------------------------------------------------
#
# Supabase gives you two connection strings (Project Settings → Database):
#
# 1. DIRECT CONNECTION (port 5432) — use this for Alembic migrations and for
#    the app itself at low-to-moderate traffic. Supports DDL, prepared
#    statements, long-lived sessions.
#
#      DATABASE_URL=postgresql://postgres:<PASSWORD>@db.xxxxxxxxx.supabase.co:5432/postgres
#
# 2. POOLED CONNECTION (port 6543, "Connection Pooling" / PgBouncer, transaction
#    mode) — use this for the running app in serverless/high-concurrency
#    deployments, where many short-lived connections would otherwise exhaust
#    Supabase's direct connection limit. Do NOT run Alembic against this URL.
#
#      DATABASE_URL=postgresql://postgres.xxxxxxxxx:<PASSWORD>@aws-0-<region>.pooler.supabase.com:6543/postgres
#
# app/database/database.py auto-detects port 6543 and disables SQLAlchemy's
# own connection pool accordingly (PgBouncer already pools upstream).
#
DATABASE_URL=postgresql://postgres:<PASSWORD>@db.xxxxxxxxx.supabase.co:5432/postgres

# --- App metadata ------------------------------------------------------------
APP_NAME="Local RAG API"
APP_VERSION=1.0.0
ENVIRONMENT=development
DEBUG=false

# --- Connection pool tuning (ignored when using the port-6543 pooler URL) ---
DB_POOL_SIZE=5
DB_MAX_OVERFLOW=10
DB_POOL_TIMEOUT=30
DB_POOL_RECYCLE=1800
DB_ECHO=false

# --- Local file storage (document uploads) -----------------------------------
# Relative paths resolve against the process's working directory.
UPLOAD_DIR=uploads
MAX_UPLOAD_SIZE_MB=25

# --- Document text processing (parse / chunk) ---------------------------------
CHUNK_SIZE=1000
CHUNK_OVERLAP=200

# --- Embeddings (Ollama) -------------------------------------------------------
# OLLAMA_HOST overrides OLLAMA_BASE_URL when set.
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_HOST=http://localhost:11434
EMBEDDING_MODEL=nomic-embed-text
EMBEDDING_DIMENSIONS=768

# --- Vector retrieval ----------------------------------------------------------
TOP_K=10
SIMILARITY_THRESHOLD=0.0

# --- Prompt building -----------------------------------------------------------
MAX_CONTEXT_CHARS=8000
SYSTEM_PROMPT="You are a helpful assistant that answers questions using only the provided document excerpts. Reference chunk numbers when citing sources. If the excerpts do not contain enough information, say so clearly instead of guessing."

# --- Chat LLM (Ollama) ---------------------------------------------------------
# OLLAMA_MODEL overrides CHAT_MODEL when set. Default remains qwen3:8b.
CHAT_MODEL=qwen3:8b
OLLAMA_MODEL=qwen3:8b
OLLAMA_VISION_MODEL=qwen3-vl:4b
SUPABASE_STORAGE_BUCKET=chat-images

# --- Agentic AI Model Routing --------------------------------------------------
MODEL_ROUTER_CLASSIFY=qwen3:4b
MODEL_QUERY_REWRITE=qwen3:4b
MODEL_RAG_REASONING=qwen3:8b
MODEL_COMPLEX_REASONING=qwen3:8b
MODEL_FINAL_ANSWER=qwen3:8b
# qwen3:8b typically needs more than 4 GB VRAM for full GPU offload.
# Set OLLAMA_USE_GPU=false on small GPUs (e.g. RTX 3050 4GB) to force CPU
# (options.num_gpu=0) and avoid CUDA_Host / out-of-memory failures.
# On this machine, prefer a smaller local model such as qwen3:4b if 8b OOMs.
OLLAMA_USE_GPU=false
# Optional: when OLLAMA_USE_GPU=true, limit layers offloaded to GPU.
# OLLAMA_NUM_GPU=20
# Optional CPU thread count for llama.cpp.
# OLLAMA_NUM_THREAD=8
# qwen3 thinking mode can take several minutes on CPU; client sends think=false for chat.
LLM_TIMEOUT_SECONDS=300
LLM_MAX_RETRIES=3
LLM_TEMPERATURE=0.7

# --- CORS (Vite SPA origins; comma-separated) --------------------------------
CORS_ALLOW_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
